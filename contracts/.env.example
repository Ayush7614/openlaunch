# Copy to .env and fill in. Never commit .env.

# Deployer EOA (pays gas; the contracts have no owner, so it keeps no powers after deploy).
DEPLOYER_PRIVATE_KEY=

# RPCs for deploys and fork tests (FORK_TESTS=true). Public nodes work; Alchemy is faster.
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=

# Etherscan V2 API key — one key verifies on every Etherscan chain, Basescan included (script/verify.sh).
ETHERSCAN_API_KEY=
