# Quiet npm install. The only remaining noise is transitive web3 deprecations
# (@walletconnect/*, @metamask/sdk, uuid, @safe-global/*, @paulmillr/qr) pulled
# by wagmi's connectors + @coinbase/x402 — upstream deprecations of THEIR deps,
# not ours, and not safely override-able without breaking the wallet/payment
# flow. loglevel=error hides those + allow-scripts notices while still showing
# real errors and the install summary. To see everything: `npm install --loglevel=warn`.
# Audit findings are moderate transitive web3 deps; run `npm audit` to review.
loglevel=error
fund=false
audit=false
